# Backend API URL (without /api suffix - used for proxy in dev)
# For local development: http://localhost:5000
# For production: leave empty (proxy not used)
VITE_BACKEND_URL=http://localhost:5000

# Backend API Base URL (with /api - used by axios)
# For local development: /api (uses proxy)
# For production: https://your-backend-url.com/api (full URL)
VITE_API_BASE_URL=/api
